

type Query{
    member: Member!
}

type Bookclub {
    id: ID!
    name: String!
    description: String
}

type Invitation{
    id: ID!
    bookclub: Bookclub!
    createdAt: String!
    invitedBy: User!
}

type User{
    id: ID!
    name: String!
}

type Member{
    id: ID!
    name: String!
    membership: [Bookclub!]!
    invitationPending: [Invitation!]!
}