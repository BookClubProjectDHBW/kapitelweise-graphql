

type Query{
    member: Member!
    bookclub(id: ID!): BookclubDetail!
}

type BookclubDetail{
    id: ID!
    bookClubName: String!
    description: String
    role: String!
}

type SentInvitation{
    id: ID!
    invitationStatus: String!
    invitedUser: String!
    createdAt: String!
}

type Bookclub {
    id: ID!
    name: String!
    description: String
}

type Invitation{
    id: ID!
    bookclub: Bookclub!
    createdAt: String!
    invitedBy: User!
}

type User{
    id: ID!
    name: String!
}

type Member{
    id: ID!
    name: String!
    membership: [Bookclub!]!
    invitationPending: [Invitation!]!
}

type Mutation{
    createNewBookClub(bookClubInput: BookClubInput!): Bookclub!
    responseInvitation(invitationInput: InvitationInput!): Bookclub
    inviteUser(inviteUserInput: InviteUserInput!): SentInvitation!
}

input InviteUserInput{
    bookclubId: ID!
    username: String!
}

input InvitationInput{
    invitationId: ID!
    status: InvitationResponseStatus!
}

enum InvitationResponseStatus{
    ACCEPTED
    DECLINED
}

input BookClubInput{
    name: String!
    description: String
}